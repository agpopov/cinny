{
  "name": "cinny",
  "version": "4.14.3",
  "description": "Yet another matrix client",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "npm run check:eslint && npm run check:prettier",
    "check:eslint": "eslint --ext .ts,.tsx,.js,.jsx src",
    "check:prettier": "prettier --check .",
    "fix:prettier": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky install",
    "commit": "node scripts/commit.mjs",
    "bump": "node scripts/update-version.js",
    "test:unread": "node --import ./tests/register-unread-source.mjs tests/unread.test.ts && node --import ./tests/register-unread-source.mjs tests/unread-regressions.test.ts",
    "test:media": "node tests/media.test.mjs",
    "test:mobile-media": "node tests/mobile-media.test.mjs",
    "test:editor-links": "node tests/editor-links.test.mjs",
    "test:composer": "node tests/composer.test.mjs",
    "test:threads": "node tests/thread-creation.test.mjs",
    "test:audit:source": "node tests/platform-audit.test.mjs",
    "test:stickers": "node tests/stickers.test.mjs",
    "test:mentions": "node --import ./tests/register-unread-source.mjs tests/mention-groups.test.ts",
    "test:unread:source": "node --import ./tests/register-unread-source.mjs tests/unread.test.ts && node --import ./tests/register-unread-source.mjs tests/unread-regressions.test.ts",
    "test:key-export": "node tests/key-export.test.mjs",
    "test:p1": "node tests/p1.test.mjs && node tests/p1-tools.test.mjs",
    "test:p2": "node --import ./tests/register-unread-source.mjs tests/p2.test.mjs",
    "test:build-compat": "node tests/build-compat.test.mjs",
    "test:routes": "node --import ./tests/register-unread-source.mjs tests/routes.test.mjs",
    "test:clipboard": "node tests/clipboard.test.mjs && node tests/native-clipboard.test.mjs",
    "test:i18n": "node tests/i18n.test.mjs",
    "test:client-fixes": "node tests/message-preview.test.mjs && node tests/message-urls.test.mjs && node tests/back-navigation.test.mjs && node tests/room-navigation.test.mjs && node tests/panel-width.test.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint",
    "*": "prettier --ignore-unknown --write"
  },
  "keywords": [],
  "author": "Ajay Bura",
  "license": "AGPL-3.0-only",
